@model Asp.Net_MVC.ViewModel.EditUserVm

<div class="container">

    <form method="post">

        <input hidden asp-for="UserId"/>

        <input asp-for="Name" class="form-control mb-2"/>

        <input asp-for="ContactNo" class="form-control mb-2"/>

        <input asp-for="UserName" class="form-control mb-2"/>

        <input asp-for="Email" class="form-control mb-2"/>

        <input asp-for="Address" class="form-control mb-2"/>

        <button class="btn btn-primary">Update</button>

    </form>

</div>