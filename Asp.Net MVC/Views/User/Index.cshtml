@model List<Asp.Net_MVC.ViewModel.UserReportVm>

<a asp-action="Create" class="btn btn-success mb-3">
    Add User
</a>

<table class="table table-bordered">

    <tr>
        <th>Name</th>
        <th>Contact</th>
        <th>Username</th>
        <th>Email</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach(var u in Model)
    {
        <tr>

            <td>@u.Name</td>
            <td>@u.ContactNo</td>
            <td>@u.Username</td>
            <td>@u.Email</td>

            @if(u.IsActive)
            {
                <td class="text-success">@u.Status</td>
            }
            else
            {
                <td class="text-danger">@u.Status</td>
            }

            <td class="d-flex gap-1">

                <a asp-action="Edit"
                   asp-route-id="@u.Id"
                   class="btn btn-primary btn-sm">Edit</a>

                @if(u.IsActive)
                {
                    <a asp-action="Delete"
                       asp-route-id="@u.Id"
                       class="btn btn-warning btn-sm">Deactivate</a>
                }
                else
                {
                    <a asp-action="Activate"
                       asp-route-id="@u.Id"
                       class="btn btn-success btn-sm">Activate</a>
                }

                <a asp-action="PermanentDelete"
                   asp-route-id="@u.Id"
                   class="btn btn-danger btn-sm">Delete</a>

            </td>

        </tr>
    }

</table>