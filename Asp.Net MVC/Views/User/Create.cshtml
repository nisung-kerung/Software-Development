@model Asp.Net_MVC.ViewModel.AddUserVm

<div class="container col-6">

    <form method="post">

        <div class="card">

            <div class="card-header">
                Create User
            </div>

            <div class="card-body">

                <input asp-for="Name" placeholder="Name" class="form-control mb-2"/>

                <input asp-for="ContactNo" placeholder="Contact" class="form-control mb-2"/>

                <input asp-for="Username" placeholder="Username" class="form-control mb-2"/>

                <input asp-for="Email" placeholder="Email" class="form-control mb-2"/>

                <input asp-for="Address" placeholder="Address" class="form-control mb-2"/>

                <input asp-for="Password" placeholder="Password" class="form-control mb-2"/>

                <input asp-for="ConfirmPassword" placeholder="Confirm Password" class="form-control mb-2"/>

            </div>

            <div class="card-footer">

                <button class="btn btn-success">Create</button>

            </div>

        </div>

    </form>

</div>