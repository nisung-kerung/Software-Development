@{
    ViewBag.Title = "Access Denied";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="text-center p-5 shadow rounded bg-white">

        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size:70px;"></i>
        </div>

        <h1 class="text-danger fw-bold">Access Denied</h1>

        <p class="text-muted mt-3">
            You do not have permission to access this page.
            Please contact the administrator if you believe this is a mistake.
        </p>

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                Go Back to Dashboard
            </a>
        </div>

    </div>
</div>