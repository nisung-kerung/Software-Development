@model MobileRepairShop.Models.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mt-4">

    <h2 class="fw-bold mb-4">
        <i class="fa-solid fa-gauge-high text-primary"></i>
        Dashboard Overview
    </h2>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 bg-primary text-white">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6>Total Customers</h6>
                        <h3>@Model.TotalCustomers</h3>
                    </div>
                    <i class="fa-solid fa-users fa-2x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 bg-warning text-dark">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6>Devices In Repair</h6>
                        <h3>@Model.DevicesInRepair</h3>
                    </div>
                    <i class="fa-solid fa-screwdriver-wrench fa-2x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 bg-success text-white">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6>Completed Repairs</h6>
                        <h3>@Model.CompletedRepairs</h3>
                    </div>
                    <i class="fa-solid fa-circle-check fa-2x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 bg-danger text-white">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6>Total Revenue</h6>
                        <h3>Rs. @Model.TotalRevenue</h3>
                    </div>
                    <i class="fa-solid fa-rupee-sign fa-2x"></i>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow border-0 rounded-4 mt-5">
        <div class="card-body">
            <h5 class="mb-4">Recent Repairs</h5>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Customer</th>
                            <th>Device</th>
                            <th>Issue</th>
                            <th>Status</th>
                            <th>Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repair in Model.RecentRepairs)
                        {
                            <tr>
                                <td>@repair.CustomerName</td>
                                <td>@repair.DeviceModel</td>
                                <td>@repair.Issue</td>
                                <td>
                                    <span class="badge bg-secondary">@repair.Status</span>
                                </td>
                                <td>Rs. @repair.Cost</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>